---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { site, wa, whatsappLink } from "../data/site";
import "../styles/contacto.css";
---

<BaseLayout
  title="Contacto — Chaco Implantes"
  description="Contactá a Chaco Implantes en Resistencia, Chaco. WhatsApp 0362-4571854, Corrientes 781."
  canonicalPath="/contacto"
>
  <div class="contacto-page">
    <section data-contacto-page class="contacto-hero page-hero-dark">
      <div class="contacto-shell contacto-hero__layout">
        <div class="contacto-hero__copy">
          <p class="contacto-hero__eyebrow">Atención profesional</p>
          <h1>Contacto</h1>
          <p>
            Escribinos para consultas comerciales, catálogos, disponibilidad de productos o coordinación institucional.
          </p>
        </div>

        <div class="contacto-hero__direct">
          <span>Respuesta directa</span>
          <p>Atendemos consultas de profesionales, clínicas y sanatorios.</p>
        </div>
      </div>
    </section>

    <section class="contacto-main">
      <div data-contacto-layout class="contacto-shell contacto-main__layout">
        <form data-contact-form class="contacto-form" novalidate>
          <header class="contacto-form__header">
            <p class="contacto-label">Consulta comercial</p>
            <h2>Contanos qué necesitás coordinar</h2>
            <p>
              Enviamos tu consulta por WhatsApp con los datos cargados para responder con mayor precisión.
            </p>
          </header>

          <div class="contacto-form__fields">
            <label>
              <span>Nombre</span>
              <input
                id="contact-nombre"
                name="nombre"
                required
                maxlength="100"
                minlength="2"
                autocomplete="name"
                aria-describedby="contact-nombre-error"
                class="contact-field"
                placeholder="Tu nombre"
              />
              <small id="contact-nombre-error" data-error-for="nombre" class="hidden" aria-live="polite"></small>
            </label>
            <label>
              <span>Institución / especialidad</span>
              <input
                id="contact-institucion"
                name="institucion"
                required
                maxlength="120"
                minlength="2"
                autocomplete="organization"
                aria-describedby="contact-institucion-error"
                class="contact-field"
                placeholder="Clínica, sanatorio o especialidad"
              />
              <small id="contact-institucion-error" data-error-for="institucion" class="hidden" aria-live="polite"></small>
            </label>
          </div>

          <label class="contacto-form__message">
            <span>Mensaje</span>
            <textarea
              id="contact-mensaje"
              name="mensaje"
              required
              maxlength="1000"
              minlength="10"
              aria-describedby="contact-mensaje-error"
              class="contact-field"
              placeholder="Contanos tu consulta, línea de producto o requerimiento"
            ></textarea>
            <small id="contact-mensaje-error" data-error-for="mensaje" class="hidden" aria-live="polite"></small>
          </label>

          <button type="submit" class="btn-primary contacto-form__submit">
            <Icon name="message-circle" class="h-4 w-4" />
            Enviar por WhatsApp
          </button>
        </form>

        <aside class="contacto-details" aria-labelledby="contacto-details-title">
          <p class="contacto-details__eyebrow">Canales de atención</p>
          <h2 id="contacto-details-title">Estamos cerca para responder</h2>

          <ul class="contacto-details__list">
            <li>
              <span class="contacto-details__icon"><Icon name="phone" class="h-5 w-5" /></span>
              <div>
                <span>WhatsApp</span>
                <a href={whatsappLink()} target="_blank" rel="noopener noreferrer">{site.phoneDisplay}</a>
              </div>
            </li>
            <li>
              <span class="contacto-details__icon"><Icon name="mail" class="h-5 w-5" /></span>
              <div>
                <span>Correo electrónico</span>
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </div>
            </li>
            <li>
              <span class="contacto-details__icon"><Icon name="instagram" class="h-5 w-5" /></span>
              <div>
                <span>Instagram</span>
                <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">{site.instagramHandle}</a>
              </div>
            </li>
          </ul>

          <a
            href={wa.consulta}
            target="_blank"
            rel="noopener noreferrer"
            class="contacto-details__action"
          >
            Iniciar una conversación
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </aside>
      </div>
    </section>

    <section data-contacto-location class="contacto-location">
      <div class="contacto-shell contacto-location__layout">
        <div class="contacto-location__map">
          <iframe
            src={`https://www.google.com/maps?q=${encodeURIComponent(site.address)}&output=embed`}
            title={`Mapa: ${site.address}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <div class="contacto-location__copy">
          <p class="contacto-label">Resistencia, Chaco</p>
          <h2>Encontranos en Corrientes 781</h2>

          <div class="contacto-location__item">
            <Icon name="map-pin" class="h-5 w-5" />
            <span>{site.address}</span>
          </div>

          <div class="contacto-location__item">
            <Icon name="clock" class="h-5 w-5" />
            <div>
              <strong>Horario comercial</strong>
              <span>Lun a vie · 8:30 a 12:30 h</span>
              <span>16:30 a 20:30 h</span>
            </div>
          </div>

          <a
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="contacto-location__action"
          >
            Cómo llegar
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline define:vars={{ whatsappBase: whatsappLink() }}>
  const form = document.querySelector("[data-contact-form]");

  const rules = {
    nombre: "Ingresá tu nombre",
    institucion: "Ingresá tu institución o especialidad",
    mensaje: "Contanos brevemente tu consulta",
  };
  let firstInvalidField = null;

  const showError = (name, message) => {
    const field = form?.querySelector(`[name="${name}"]`);
    const error = document.querySelector(`[data-error-for="${name}"]`);
    field?.setAttribute("aria-invalid", "true");
    if (!firstInvalidField && field instanceof HTMLElement) firstInvalidField = field;
    if (error) {
      error.textContent = message;
      error.classList.remove("hidden");
      error.setAttribute("role", "alert");
      window.requestAnimationFrame(() => error.setAttribute("data-visible", "true"));
    }
  };

  const clearErrors = () => {
    firstInvalidField = null;
    form?.querySelectorAll("[aria-invalid]").forEach((field) => field.removeAttribute("aria-invalid"));
    document.querySelectorAll("[data-error-for]").forEach((error) => {
      error.textContent = "";
      error.removeAttribute("data-visible");
      error.classList.add("hidden");
      error.removeAttribute("role");
    });
  };

  const validate = () => {
    if (!(form instanceof HTMLFormElement)) return null;
    clearErrors();
    const data = Object.fromEntries(new FormData(form));
    const values = {
      nombre: String(data.nombre || "").trim(),
      institucion: String(data.institucion || "").trim(),
      mensaje: String(data.mensaje || "").trim(),
    };
    let valid = true;

    for (const [key, message] of Object.entries(rules)) {
      if (!values[key] || values[key].length < (key === "mensaje" ? 10 : 2)) {
        showError(key, message);
        valid = false;
      }
    }
    if (!valid) firstInvalidField?.focus();
    return valid ? values : null;
  };

  const buildMessage = (values) =>
    `Hola, soy ${values.nombre} (${values.institucion}).\n` +
    `Consulta:\n${values.mensaje}`;

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const values = validate();
    if (!values) return;
    window.open(`${whatsappBase}?text=${encodeURIComponent(buildMessage(values))}`, "_blank", "noopener,noreferrer");
  });
</script>

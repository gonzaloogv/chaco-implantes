---
import BaseLayout from "../layouts/BaseLayout.astro";
import CatalogCard from "../components/CatalogCard.astro";
import Icon from "../components/Icon.astro";
import "../styles/home.css";
import {
  categoryImages,
  featuredCategories,
  featuredEvent,
  heroSlides,
  images,
  serviceFlow,
  supplierSystems,
  valuePillars,
  videos,
  wa,
} from "../data/site";
---

<BaseLayout canonicalPath="/">
  <div data-home-page class="home-page">
  <section id="inicio" data-home-section="hero" data-home-tone="1" data-hero-carousel class="hero-shell relative flex overflow-hidden">
    <h1 class="sr-only">Prótesis, implantes e instrumental para equipos quirúrgicos</h1>
    {heroSlides.map((slide, index) => (
      <img
        src={slide.image}
        alt={slide.imageAlt}
        fetchpriority={index === 0 ? "high" : "low"}
        loading="eager"
        decoding="async"
        data-hero-bg
        data-active={index === 0 ? "true" : "false"}
        class="hero-bg-slide hero-photo-glow pointer-events-none absolute inset-0 h-full w-full object-cover"
      />
    ))}
    <div aria-hidden="true" class="home-hero-overlay"></div>

    <div class="relative z-10 mx-auto flex w-full max-w-7xl items-center px-4 pb-12 pt-32 sm:px-6 lg:px-8 lg:pb-20 lg:pt-36">
      <div class="w-full max-w-3xl">
        <div class="relative min-h-[35rem] sm:min-h-[34rem] lg:min-h-[36rem]">
          {heroSlides.map((slide, index) => (
            <article
              data-hero-slide
              data-active={index === 0 ? "true" : "false"}
              aria-hidden={index === 0 ? "false" : "true"}
              class:list={[
                "hero-slide absolute inset-0 flex flex-col justify-center transition-[opacity,transform] duration-300 ease-out",
                index !== 0 && "pointer-events-none",
              ]}
            >
              <span class="home-hero-eyebrow inline-flex w-fit items-center gap-2 rounded-full border border-primary/35 bg-primary/15 px-3 py-2 text-xs font-bold uppercase text-brand shadow-[0_0_24px_rgba(74,144,196,0.18)]">
                <span class="h-2 w-2 rounded-full bg-primary shadow-[0_0_10px_rgba(74,144,196,0.9)]"></span>
                {slide.eyebrow}
              </span>
              <h2 class="home-hero-title mt-5 font-display text-4xl font-black leading-[1.02] text-white sm:text-5xl lg:text-7xl">
                {slide.title}
              </h2>
              <p class="home-hero-copy mt-5 max-w-2xl text-base leading-relaxed text-brand sm:text-xl">{slide.text}</p>
              <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <a href={slide.href} class="btn-primary-soft inline-flex w-full items-center justify-center gap-2 rounded-md px-6 py-3.5 text-sm font-bold sm:w-auto">
                  {slide.ctaLabel} <Icon name="arrow-right" class="h-4 w-4" />
                </a>
                <a
                  href={wa.general}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-glass-outline inline-flex w-full items-center justify-center gap-2 rounded-md px-6 py-3.5 text-sm font-bold sm:w-auto"
                >
                  <Icon name="message-circle" class="h-4 w-4" /> Contactar por WhatsApp
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
    <div class="hero-dot-controls absolute bottom-6 left-1/2 z-20 -translate-x-1/2 lg:bottom-10" role="group" aria-label="Control de slides del hero">
      <div class="flex items-center gap-2 py-2">
        {heroSlides.map((slide, index) => (
          <button
            type="button"
            data-hero-dot
            data-index={index}
            aria-label={`Ver ${slide.title}`}
            aria-pressed={index === 0 ? "true" : "false"}
            class="hero-dot h-2.5 rounded-full transition-[width,background-color,opacity] duration-200 ease-out"
          ></button>
        ))}
        <button
          type="button"
          data-hero-autoplay
          aria-pressed="false"
          aria-label="Pausar rotación automática"
          class="ml-2 inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-white transition-colors duration-200 ease-out hover:bg-white/20"
        >
          <span data-hero-pause-icon><Icon name="pause" class="h-3.5 w-3.5" /></span>
          <span data-hero-play-icon class="hidden"><Icon name="play" class="h-3.5 w-3.5" /></span>
        </button>
      </div>
    </div>
  </section>

  <section
    data-home-section="features"
    data-home-tone="2"
    class="home-accent-rail home-accent-rail--hero-overlap"
  >
    <div data-home-accent-band class="home-accent-band">
      <h2 class="sr-only">Diferenciales de Chaco Implantes</h2>
      <div class="home-accent-grid">
        {valuePillars.map((pillar) => (
          <article data-value-pillar class="home-accent-item">
            <span class="home-accent-icon">
              <Icon name={pillar.icon} class="h-5 w-5" />
            </span>
            <p class="home-accent-label">{pillar.label}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section data-home-section="products" data-home-tone="0" class="home-content-section home-content-section--base">
    <div class="home-content-section__inner">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="home-section-heading">
          <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase text-primary">
            <span class="h-px w-6 bg-brand"></span>
            Catálogo por especialidad
          </span>
          <h2 class="mt-3 font-display text-2xl font-extrabold text-deep sm:text-4xl">Líneas de productos</h2>
          <p class="mt-2 max-w-2xl text-muted-foreground">Prótesis, implantes e instrumental organizados por especialidad.</p>
        </div>
        <a href="/catalogos" class="link-primary-soft inline-flex items-center gap-1.5 text-sm font-semibold">
          Ver todos los catálogos <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <div class="home-products-grid">
        {featuredCategories.map((category) => <CatalogCard category={category} compact />)}
      </div>
    </div>
  </section>

  <section data-home-section="suppliers" data-home-tone="0" data-suppliers-section class="home-content-section home-content-section--tint">
    <div class="home-content-section__inner">
      <div class="home-section-heading">
        <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase text-primary-glow">
          <span class="h-px w-6 bg-primary-glow"></span>
          Proveedores y sistemas
        </span>
        <h2 class="mt-3 font-display text-2xl font-extrabold sm:text-3xl">Líneas destacadas para resolver cada procedimiento</h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed sm:text-base">
          Combinamos sistemas internacionales, líneas exclusivas y productos nacionales para dar respuesta comercial, disponibilidad e instrumental según cada caso.
        </p>
      </div>

      <div class="home-suppliers-grid">
        {supplierSystems.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="supplier-brand-card"
            aria-label={`Visitar sitio de ${item.name}`}
          >
            <img
              src={item.logo}
              alt={item.logoAlt}
              width={item.logoWidth}
              height={item.logoHeight}
              loading="lazy"
              decoding="async"
              class:list={["supplier-logo", item.logoClass]}
            />
          </a>
        ))}
        <a
          href={wa.lineaFaltante}
          target="_blank"
          rel="noopener noreferrer"
          class="supplier-brand-card supplier-brand-card-muted group"
        >
          <span class="font-display text-sm font-semibold text-brand">Consultar otras líneas</span>
          <Icon name="arrow-right" class="h-4 w-4 text-brand transition-transform duration-200 ease-out group-hover:translate-x-1" />
        </a>
      </div>
    </div>
  </section>

  <section
    aria-labelledby="home-process-title"
    data-home-section="process"
    data-home-tone="2"
    class="home-accent-rail"
  >
    <div data-home-accent-band class="home-accent-band">
      <h2 id="home-process-title" class="sr-only">Cómo coordinamos cada solicitud</h2>
      <ol class="home-accent-grid home-process-grid">
        {serviceFlow.map((item) => (
          <li class="home-accent-item home-process-item">
            <span class="home-process-step" aria-hidden="true">{item.step}</span>
            <span>{item.label}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section data-home-section="congresses" data-home-tone="0" class="home-content-section home-content-section--base">
    <div class="home-content-section__inner">
      <div class="home-section-heading">
        <h2 class="font-display text-2xl font-extrabold text-deep sm:text-3xl">Presencia activa en congresos y formación profesional</h2>
      </div>

      <article class="home-event-card">
        <div class="relative aspect-[16/10] md:aspect-auto">
          <img
            src={featuredEvent.image}
            alt={featuredEvent.imageAlt}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="flex flex-col justify-center p-6 sm:p-8">
          <span class="inline-flex w-fit items-center rounded-full bg-secondary px-3 py-1 text-xs font-medium text-primary ring-1 ring-border">
            {featuredEvent.badge}
          </span>
          <h3 class="mt-3 font-display text-xl font-semibold text-deep">
            {featuredEvent.title}
          </h3>
          <p class="mt-1 flex items-center gap-1.5 text-sm text-muted-foreground">
            <Icon name="map-pin" class="h-4 w-4 text-primary" /> {featuredEvent.venue}
          </p>
          <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
            {featuredEvent.description}
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a
              href={wa.congreso}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary inline-flex w-fit items-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold"
            >
              <Icon name="message-circle" class="h-4 w-4" /> Consultanos
            </a>
            <a href="/eventos" class="btn-secondary inline-flex w-fit items-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold">
              Ver todos los eventos <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </article>

    </div>
  </section>

  <section data-home-section="multimedia" data-home-tone="0" class="home-content-section home-content-section--tint">
    <div class="home-content-section__inner">
      <div class="home-section-heading">
        <h2 class="font-display text-2xl font-extrabold sm:text-3xl">
          {videos.length > 0
            ? "Productos, instrumental y quirófano, en imágenes y video"
            : "Productos, instrumental y quirófano, en imágenes"}
        </h2>
        <p class="mt-2">
          {videos.length > 0
            ? "Fotos y recorridos audiovisuales de las líneas, el instrumental y la actividad con profesionales e instituciones."
            : "Fotos de las líneas, el instrumental y la actividad con profesionales e instituciones."}
        </p>
      </div>

      <div class:list={["home-media-grid", videos.length === 0 && "home-media-grid--single"]}>
        <a data-home-media-card="gallery" href="/galeria" class="home-media-card catalog-image-card card-link group">
          <img
            src={categoryImages["instrumental-quirurgico"]}
            alt="Galería de productos e instrumental"
            loading="lazy"
            decoding="async"
            width="1024"
            height="768"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-deep via-deep/55 to-deep/5"></div>
          <div class="relative p-6">
            <h3 class="font-display text-lg font-semibold text-white">Galería de imágenes</h3>
            <span class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-white">
              <Icon name="images" class="h-4 w-4" /> Ver galería
              <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-200 ease-out group-hover:translate-x-1" />
            </span>
          </div>
        </a>

        {videos.length > 0 && (
          <a data-home-media-card="videos" href="/videos" class="home-media-card catalog-image-card card-link group">
            <img
              src={images.quirofano}
              alt="Videos institucionales"
              loading="lazy"
              decoding="async"
              width="1024"
              height="768"
              class="absolute inset-0 h-full w-full object-cover"
            />
            <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-deep via-deep/55 to-deep/5"></div>
            <div class="relative p-6">
              <h3 class="font-display text-lg font-semibold text-white">Videos</h3>
              <span class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-white">
                <Icon name="play-circle" class="h-4 w-4" /> Ver videos
                <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-200 ease-out group-hover:translate-x-1" />
              </span>
            </div>
          </a>
        )}
      </div>
    </div>
  </section>

  <section
    id="profesionales"
    data-home-section="cta"
    data-home-tone="2"
    class="home-accent-rail home-accent-rail--footer-overlap scroll-mt-20"
  >
    <div data-home-accent-band class="home-accent-band">
      <div class="home-accent-cta">
        <div class="home-accent-cta__copy">
          <p class="home-accent-cta__eyebrow">
          Calidad que se siente. Confianza que se nota.
          </p>
          <h2>Trabajamos con traumatólogos, cirujanos, clínicas y sanatorios</h2>
          <p>
            Consultas comerciales e institucionales: coordinamos pedidos,
            disponibilidad y suministro de prótesis, implantes e instrumental.
          </p>
        </div>
        <a
          href={wa.general}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-light inline-flex items-center justify-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold"
        >
          <Icon name="message-circle" class="h-4 w-4" /> WhatsApp
        </a>
        <a
          href="/catalogos"
          class="btn-glass-outline inline-flex items-center justify-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold"
        >
          Ver catálogos <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>

<script>
  const carousel = document.querySelector("[data-hero-carousel]");
  if (carousel instanceof HTMLElement) {
    const slides = Array.from(carousel.querySelectorAll("[data-hero-slide]"));
    const backgrounds = Array.from(carousel.querySelectorAll("[data-hero-bg]"));
    const dots = Array.from(carousel.querySelectorAll("[data-hero-dot]"));
    const autoplayToggle = carousel.querySelector("[data-hero-autoplay]");
    const pauseIcon = carousel.querySelector("[data-hero-pause-icon]");
    const playIcon = carousel.querySelector("[data-hero-play-icon]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const AUTO_ADVANCE_MS = 6500;

    let active = 0;
    let timer: number | undefined;
    // "auto": el hover sobre el hero pausa. Al presionar el botón, el usuario toma
    // control y su decisión tiene prioridad sobre el hover ("playing" | "paused").
    let manualState: "auto" | "playing" | "paused" = "auto";
    let heroHover = false;
    let inView = true;

    // ¿Está rotando de verdad ahora mismo?
    const isPlaying = () => {
      if (!inView || reduceMotion.matches) return false; // restricciones del entorno
      if (manualState === "playing") return true;         // el botón manda sobre el hover
      if (manualState === "paused") return false;
      return !heroHover;                                  // auto: el hover pausa
    };

    const setActive = (index: number) => {
      active = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === active;
        if (slide instanceof HTMLElement) {
          slide.dataset.active = String(isActive);
          slide.setAttribute("aria-hidden", String(!isActive));
          slide.classList.toggle("pointer-events-none", !isActive);
        }
      });
      backgrounds.forEach((background, backgroundIndex) => {
        if (background instanceof HTMLElement) {
          background.dataset.active = String(backgroundIndex === active);
        }
      });
      dots.forEach((dot, dotIndex) => {
        dot.setAttribute("aria-pressed", String(dotIndex === active));
      });
    };

    const stopAuto = () => {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    // El ícono/label del botón refleja el estado REAL (reproduciendo vs pausado)
    const syncButton = (playing: boolean) => {
      if (!(autoplayToggle instanceof HTMLElement)) return;
      // reproduciendo → ícono de pausa (acción disponible); pausado → ícono de play
      pauseIcon?.classList.toggle("hidden", !playing);
      playIcon?.classList.toggle("hidden", playing);
      autoplayToggle.setAttribute("aria-pressed", String(!playing));
      autoplayToggle.setAttribute(
        "aria-label",
        playing ? "Pausar rotación automática" : "Reanudar rotación automática",
      );
    };

    // Un solo punto de decisión: rota solo si isPlaying(), y sincroniza el indicador
    const syncAuto = () => {
      stopAuto();
      const playing = isPlaying();
      if (playing) timer = window.setInterval(() => setActive(active + 1), AUTO_ADVANCE_MS);
      syncButton(playing);
    };

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        setActive(index);
        syncAuto();
      });
    });

    // El botón fija la decisión del usuario y tiene prioridad sobre el hover:
    // si está pausado (por el motivo que sea) y se presiona, fuerza reproducción.
    autoplayToggle?.addEventListener("click", () => {
      manualState = isPlaying() ? "paused" : "playing";
      syncAuto();
    });

    carousel.addEventListener("pointerenter", () => {
      heroHover = true;
      syncAuto();
    });
    carousel.addEventListener("pointerleave", () => {
      heroHover = false;
      syncAuto();
    });

    new IntersectionObserver((entries) => {
      inView = entries.some((entry) => entry.isIntersecting);
      syncAuto();
    }).observe(carousel);

    reduceMotion.addEventListener("change", syncAuto);
    syncAuto();
  }
</script>

---
import CatalogViewer from "../../components/CatalogViewer.astro";
import Icon from "../../components/Icon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  categories,
  catalogProducts,
  categoryImages,
  catalogPreviewImages,
  whatsappLink,
} from "../../data/site";
import "../../styles/catalogo-especialidad.css";

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { categoria: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const image =
  categoryImages[category.slug as keyof typeof categoryImages];
const products = catalogProducts.filter(
  (product) => product.categorySlug === category.slug,
);
const hasCatalogPreview = category.slug in catalogPreviewImages;
const hasProducts = products.length > 0;
const productCountLabel = `${products.length} ${
  products.length === 1 ? "producto disponible" : "productos disponibles"
}`;
---

<BaseLayout
  title={`${category.title} · Catálogo — Chaco Implantes`}
  description={category.description}
  canonicalPath={`/catalogos/${category.slug}`}
>
  <div class="catalog-specialty-page">
    <section
      class="catalog-specialty-hero"
      data-catalog-specialty-hero
      aria-labelledby="catalog-specialty-title"
    >
      <div class="catalog-specialty-shell catalog-specialty-hero__layout">
        <div class="catalog-specialty-hero__copy">
          <a href="/catalogos" class="catalog-specialty-back">
            <Icon name="arrow-left" class="h-4 w-4" />
            Volver a catálogos
          </a>

          <p class="catalog-specialty-eyebrow">{category.type}</p>
          <h1 id="catalog-specialty-title">{category.title}</h1>
          <p class="catalog-specialty-hero__description">
            {category.description}
          </p>

          <a
            href={hasProducts ? "#productos" : "#solicitar-catalogo"}
            class="catalog-specialty-hero__action"
          >
            {hasProducts ? "Explorar productos" : "Solicitar documentación"}
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>

        <div
          class:list={[
            "catalog-specialty-hero__visual",
            hasCatalogPreview && "catalog-specialty-hero__visual--preview",
          ]}
          data-catalog-specialty-image
        >
          <span
            class="catalog-specialty-hero__accent"
            aria-hidden="true"
          ></span>
          <img
            src={image}
            alt={category.title}
            loading="eager"
            decoding="async"
            width="1024"
            height="768"
          />
          {hasProducts && (
            <p class="catalog-specialty-hero__count">
              <strong>{products.length}</strong>
              <span>
                {products.length === 1
                  ? "producto disponible"
                  : "productos disponibles"}
              </span>
            </p>
          )}
        </div>
      </div>
    </section>

    <section
      id={hasProducts ? "productos" : "solicitar-catalogo"}
      class="catalog-specialty-content"
    >
      <div class="catalog-specialty-shell">
        {hasProducts ? (
          <>
            <header class="catalog-specialty-directory__header">
              <div>
                <p class="catalog-specialty-label">{productCountLabel}</p>
                <h2>Explorá la línea {category.title}</h2>
                <p>
                  Revisá cada producto y accedé a su ficha para consultar el
                  catálogo y la documentación disponible.
                </p>
              </div>
              <a
                href={whatsappLink(
                  `Hola, quisiera información sobre productos del catálogo de ${category.title}.`,
                )}
                target="_blank"
                rel="noopener noreferrer"
                class="catalog-specialty-button"
              >
                <Icon name="message-circle" class="h-4 w-4" />
                Consultar línea
              </a>
            </header>

            <div
              data-catalog-products
              class="catalog-specialty-grid"
            >
              {products.map((product) => (
                <article
                  data-catalog-product
                  class="catalog-specialty-card"
                >
                  <a
                    href={product.href}
                    class="catalog-specialty-card__link"
                    aria-label={`Ver catálogo de ${product.title}`}
                  >
                    <div class="catalog-specialty-card__media">
                      <img
                        src={product.image}
                        alt={product.title}
                        loading="lazy"
                        decoding="async"
                        width="1024"
                        height="768"
                      />
                    </div>

                    <div class="catalog-specialty-card__body">
                      <p class="catalog-specialty-card__label">
                        {product.label}
                      </p>
                      <h3>{product.title}</h3>
                      <p class="catalog-specialty-card__description">
                        {product.description}
                      </p>
                      <strong>
                        Ver producto
                        <Icon name="arrow-right" class="h-4 w-4" />
                      </strong>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </>
        ) : (
          <CatalogViewer
            title={category.title}
            eyebrow={category.type}
            image={image}
            whatsappMessage={`Hola, quisiera información sobre el catálogo de ${category.title}.`}
          />
        )}
      </div>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import {
  categories,
  categoryImages,
  catalogPreviewImages,
  wa,
} from "../../data/site";
import "../../styles/catalogos.css";

const catalogGroups = [
  {
    id: "articular",
    number: "01",
    title: "Reconstrucción articular",
    description:
      "Sistemas protésicos para procedimientos primarios, parciales y de revisión.",
    slugs: ["cadera", "rodilla", "hombro"],
  },
  {
    id: "fixacion",
    number: "02",
    title: "Fijación y especialidades",
    description:
      "Soluciones de osteosíntesis y fijación para distintas regiones anatómicas.",
    slugs: [
      "columna",
      "maxilofacial",
      "osteosintesis-placas",
      "osteosintesis-tornillos",
    ],
  },
  {
    id: "soporte",
    number: "03",
    title: "Soporte quirúrgico",
    description:
      "Instrumental, cajas e insumos que acompañan cada procedimiento.",
    slugs: ["instrumental-quirurgico", "otros-productos"],
  },
] as const;

const findCategory = (slug: string) => {
  const category = categories.find((item) => item.slug === slug);
  if (!category) throw new Error(`Categoría de catálogo no encontrada: ${slug}`);
  return category;
};

const directoryGroups = catalogGroups.map((group) => ({
  ...group,
  items: group.slugs.map(findCategory),
}));

const hasCatalogPreview = (slug: string) => slug in catalogPreviewImages;
---

<BaseLayout
  title="Catálogos — Chaco Implantes"
  description="Catálogos de cadera, rodilla, hombro, columna, maxilofacial, osteosíntesis e instrumental quirúrgico."
  canonicalPath="/catalogos"
>
  <div class="catalogos-page">
    <section class="catalogos-hero page-hero-dark">
      <div class="catalogos-shell catalogos-hero__layout">
        <div class="catalogos-hero__copy">
          <p class="catalogos-label catalogos-label--dark">Catálogo técnico</p>
          <h1>Catálogos</h1>
          <p>
            Prótesis, implantes e instrumental agrupados por especialidad para
            facilitar la consulta de cada familia de producto.
          </p>
          <div class="catalogos-hero__actions">
            <a class="catalogos-button catalogos-button--primary" href="#catalog-directory">
              Explorar especialidades
              <Icon name="arrow-down" class="h-4 w-4" />
            </a>
            <a
              class="catalogos-button catalogos-button--text"
              href={wa.catalogos}
              target="_blank"
              rel="noopener noreferrer"
            >
              Consultar por WhatsApp
              <Icon name="message-circle" class="h-4 w-4" />
            </a>
          </div>
        </div>

        <nav
          data-catalog-hero-index
          class="catalogos-hero__index"
          aria-label="Índice de especialidades"
        >
          <p>{categories.length} especialidades</p>
          <ol>
            {categories.map((category) => (
              <li>
                <a href={`#${category.slug}`}>{category.title}</a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </section>

    <section
      id="catalog-directory"
      data-catalog-directory
      class="catalogos-directory"
    >
      <div class="catalogos-shell">
        <header class="catalogos-intro">
          <div>
            <p class="catalogos-label">Directorio de productos</p>
            <h2>Elegí una especialidad</h2>
          </div>
          <p>
            Cada acceso reúne los sistemas, componentes e instrumental
            disponibles para esa línea.
          </p>
        </header>

        {directoryGroups.map((group) => (
          <section
            data-catalog-group={group.id}
            class={`catalogos-group catalogos-group--${group.id}`}
            aria-labelledby={`catalog-group-${group.id}`}
          >
            <header class="catalogos-group__header">
              <span>{group.number}</span>
              <div>
                <h2 id={`catalog-group-${group.id}`}>{group.title}</h2>
                <p>{group.description}</p>
              </div>
            </header>

            <div class="catalogos-group__grid">
              {group.items.map((category) => (
                <a
                  id={category.slug}
                  data-catalog-category
                  href={`/catalogos/${category.slug}`}
                  class:list={[
                    "catalogos-card",
                    hasCatalogPreview(category.slug) &&
                      "catalogos-card--preview",
                  ]}
                  aria-label={`Ver catálogo de ${category.title}`}
                >
                  <div class="catalogos-card__media">
                    <img
                      src={categoryImages[category.slug as keyof typeof categoryImages]}
                      alt={category.title}
                      loading="lazy"
                      decoding="async"
                      width="1024"
                      height="768"
                    />
                  </div>
                  <div class="catalogos-card__body">
                    <p>{category.tag}</p>
                    <h3>{category.title}</h3>
                    <span>{category.description}</span>
                    <strong>
                      Ver especialidad
                      <Icon name="arrow-right" class="h-4 w-4" />
                    </strong>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}

        <section data-catalog-cta class="catalogos-cta">
          <div>
            <p class="catalogos-label catalogos-label--dark">Consulta comercial</p>
            <h2>¿Necesitás una línea o medida específica?</h2>
            <p>
              Te ayudamos a revisar disponibilidad, alternativas e instrumental
              para el procedimiento.
            </p>
          </div>
          <a
            href={wa.lineaFaltante}
            target="_blank"
            rel="noopener noreferrer"
            class="catalogos-button catalogos-button--light"
          >
            Consultar por WhatsApp
            <Icon name="message-circle" class="h-4 w-4" />
          </a>
        </section>
      </div>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { images, site } from "../data/site";
import "../styles/nosotros.css";

const storyBackdrop =
  "https://res.cloudinary.com/dz9tuwczf/image/upload/f_auto,q_auto,c_fill,g_auto,w_900,h_1100/v1785277685/chaco-34_pof7i8.jpg";

const features = [
  {
    icon: "package-check",
    title: "Distribución traumatológica",
    text: "Prótesis, implantes e instrumental nacional e importado para distintas especialidades.",
  },
  {
    icon: "map-pin",
    title: "Base en Resistencia",
    text: "Atención comercial desde Corrientes 781, Resistencia, Chaco.",
  },
  {
    icon: "stethoscope",
    title: "Acompañamiento profesional",
    text: "Coordinación con traumatólogos, cirujanos, clínicas y sanatorios.",
  },
  {
    icon: "file-text",
    title: "Catálogos por línea",
    text: "Cadera, rodilla, columna, osteosíntesis, maxilofacial e instrumental.",
  },
];
---

<BaseLayout
  title="Nosotros — Chaco Implantes"
  description="Chaco Implantes: distribución de prótesis, implantes e instrumental traumatológico en Resistencia, Chaco, con atención a profesionales e instituciones."
  canonicalPath="/nosotros"
>
  <div class="nosotros-page">
    <section data-nosotros-page class="nosotros-hero page-hero-dark">
      <div class="nosotros-shell nosotros-hero__layout">
        <div class="nosotros-hero__copy">
          <h1>Nosotros</h1>
          <p class="nosotros-hero__intro">
            Distribuimos prótesis, implantes e instrumental traumatológico para profesionales e instituciones de salud.
          </p>
          <p class="nosotros-hero__statement">Calidad que se siente. Confianza que se nota.</p>
        </div>

        <figure data-nosotros-hero-media class="nosotros-hero__media">
          <img
            src={images.professionalWork}
            alt="Preparación y organización de instrumental en Chaco Implantes"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            width="1200"
            height="900"
          />
          <figcaption>
            Coordinación comercial, disponibilidad e instrumental para procedimientos programados.
          </figcaption>
        </figure>
      </div>
    </section>

    <section data-nosotros-story class="nosotros-story">
      <div class="nosotros-shell nosotros-story__layout">
        <div class="nosotros-story__copy">
          <p class="nosotros-label">Chaco Implantes</p>
          <h2>Productos traumatológicos con atención profesional</h2>
          <p>
            {site.name} acompaña a equipos médicos e instituciones con coordinación de implantes, instrumental y líneas de producto para traumatología.
          </p>
          <p>
            Nuestra tarea combina disponibilidad comercial, respuesta cercana y seguimiento de cada requerimiento para que el profesional pueda consultar por especialidad, sistema o procedimiento.
          </p>
          <a href="/contacto" class="btn-primary nosotros-story__action">
            Contactar a Chaco Implantes
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>

        <figure class="nosotros-story__media">
          <img
            src={storyBackdrop}
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
            width="900"
            height="1100"
            class="nosotros-story__backdrop"
          />
          <img
            src={images.homeGallery}
            alt="Preparación y control de instrumental en Chaco Implantes"
            loading="lazy"
            decoding="async"
            width="1400"
            height="960"
            class="nosotros-story__image"
          />
          <figcaption>Atención cercana para profesionales e instituciones de salud.</figcaption>
        </figure>
      </div>
    </section>

    <section class="nosotros-capabilities" aria-labelledby="nosotros-capabilities-title">
      <div class="nosotros-shell nosotros-capabilities__layout">
        <header class="nosotros-capabilities__header">
          <p class="nosotros-label">Nuestra forma de trabajar</p>
          <h2 id="nosotros-capabilities-title">Una respuesta pensada para el trabajo profesional</h2>
        </header>

        <ul data-nosotros-feature-list class="nosotros-feature-list">
          {
            features.map((feature) => (
              <li data-nosotros-feature class="nosotros-feature">
                <span class="nosotros-feature__icon" aria-hidden="true">
                  <Icon name={feature.icon} class="h-5 w-5" />
                </span>
                <div>
                  <h3>{feature.title}</h3>
                  <p>{feature.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

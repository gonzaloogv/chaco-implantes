---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { featuredEvent, images, wa } from "../data/site";
import "../styles/eventos.css";
---

<BaseLayout
  title="Capacitaciones y novedades — Chaco Implantes"
  description="Capacitaciones, jornadas y novedades de Chaco Implantes para profesionales e instituciones de salud en Resistencia, Chaco."
  canonicalPath="/eventos"
>
  <div class="eventos-page">
    <section data-eventos-page class="eventos-hero page-hero-dark">
      <div class="eventos-shell eventos-hero__layout">
        <div class="eventos-hero__copy">
          <h1>Capacitaciones y novedades</h1>
          <p>
            Participamos activamente en congresos, capacitaciones y espacios de intercambio para acercar novedades, fortalecer el vínculo con profesionales y acompañar la actualización de equipos médicos e instituciones de salud.
          </p>
        </div>

        <figure data-eventos-hero-media class="eventos-hero__media">
          <img
            src={images.heroEventos}
            alt="Chaco Implantes en eventos profesionales"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            width="1400"
            height="900"
          />
          <figcaption>
            Novedades, congresos y espacios de intercambio junto a profesionales del rubro.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="eventos-featured page-surface">
      <article
        data-featured-event
        data-eventos-featured-layout
        class="eventos-shell eventos-featured__layout"
      >
        <figure class="eventos-featured__media">
          <img
            src={featuredEvent.image}
            alt={featuredEvent.imageAlt}
            loading="lazy"
            decoding="async"
            width="1400"
            height="1000"
          />
          <figcaption>{featuredEvent.badge}</figcaption>
        </figure>

        <div class="eventos-featured__copy">
          <p class="eventos-label">Presencia profesional</p>
          <h2>{featuredEvent.title}</h2>
          <p class="eventos-featured__venue">
            <Icon name="map-pin" class="h-5 w-5" />
            <span>{featuredEvent.venue}</span>
          </p>
          <p class="eventos-featured__description">{featuredEvent.description}</p>
          <div class="eventos-featured__actions">
            <a
              href={wa.congreso}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary eventos-button"
            >
              <Icon name="message-circle" class="h-4 w-4" />
              Consultanos
            </a>
            <a href="/galeria?categoria=Eventos" class="btn-secondary eventos-button">
              Ver imágenes
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </article>
    </section>

    <section data-eventos-agenda class="eventos-agenda">
      <div class="eventos-shell eventos-agenda__layout">
        <section class="eventos-agenda__upcoming" aria-labelledby="eventos-upcoming-title">
          <span class="eventos-agenda__icon" aria-hidden="true">
            <Icon name="calendar-clock" class="h-6 w-6" />
          </span>
          <div>
            <p class="eventos-label">Agenda</p>
            <h2 id="eventos-upcoming-title">Próximas actividades</h2>
            <p>
              Publicaremos nuevas fechas, jornadas y capacitaciones para equipos profesionales cuando estén confirmadas.
            </p>
          </div>
        </section>

        <section class="eventos-agenda__contact" aria-labelledby="eventos-contact-title">
          <h2 id="eventos-contact-title">Consultas sobre capacitaciones</h2>
          <p>
            Escribinos para conocer novedades, coordinar una visita técnica o solicitar información sobre líneas de producto para instituciones.
          </p>
          <a
            href={wa.capacitaciones}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary eventos-button"
          >
            <Icon name="message-circle" class="h-4 w-4" />
            Consultar por WhatsApp
          </a>
        </section>
      </div>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import VideoPlayer from "../components/VideoPlayer.astro";
import { galleryFilters, images, videos } from "../data/site";
import "../styles/videos.css";

// Filtros solo para categorías que realmente tienen videos (evita filtros vacíos)
const usedCategories = galleryFilters.filter((filter) => videos.some((video) => video.category === filter));
const showFilters = usedCategories.length >= 2;
const featuredVideo = videos.find((video) => video.category === "Eventos") ?? videos[0];
const libraryVideos = featuredVideo
  ? videos.filter((video) => video.id !== featuredVideo.id)
  : [];
const VIDEO_PAGE_SIZE = 12;
---

<BaseLayout
  title="Videos — Chaco Implantes"
  description="Videos institucionales y de productos de Chaco Implantes. Reproducción bajo demanda."
  canonicalPath="/videos"
>
  <div class="videos-page">
    <section data-videos-page data-videos-hero class="videos-hero page-hero-dark">
      <div class="videos-shell videos-hero__layout">
        <div class="videos-hero__copy">
          <p class="videos-label videos-label--dark">Archivo audiovisual</p>
          <h1>Videos y recorridos</h1>
          <p>
            Contenido audiovisual de instrumental, productos y participación profesional,
            disponible bajo demanda para equipos médicos e instituciones.
          </p>
          <a data-videos-hero-action class="videos-hero__action" href="/galeria">
            <Icon name="images" class="h-4 w-4" />
            Ver galería
          </a>
          <dl class="videos-hero__facts">
            <div>
              <dt>Archivo</dt>
              <dd>{videos.length} videos</dd>
            </div>
            <div>
              <dt>Contenido</dt>
              <dd>Reproducción bajo demanda</dd>
            </div>
          </dl>
        </div>

        <figure class="videos-hero__media">
          <img
            src={images.homeVideos}
            alt="Actividad profesional de Chaco Implantes en un congreso de traumatología"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            width="1200"
            height="960"
          />
          <figcaption>
            <Icon name="play-circle" class="h-5 w-5" />
            Experiencias, productos y formación
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="videos-content">
      <div class="videos-shell">
        {showFilters && (
          <div class="videos-filters" data-video-filters>
            <span>Explorar por tema</span>
            <div>
              {["Todos", ...usedCategories].map((filter) => (
                <button
                  type="button"
                  data-video-filter={filter}
                  aria-pressed={filter === "Todos" ? "true" : "false"}
                  class:list={[
                    "videos-filter",
                    filter === "Todos" ? "videos-filter-active" : "videos-filter-idle",
                  ]}
                >
                  {filter}
                </button>
              ))}
            </div>
          </div>
        )}

        {featuredVideo ? (
          <>
            <article
              data-video-item
              data-video-featured
              data-category={featuredVideo.category}
              class="videos-featured"
            >
              <div class="videos-featured__player">
                <VideoPlayer
                  assetId={featuredVideo.id}
                  src={featuredVideo.src}
                  poster={featuredVideo.poster}
                  title={featuredVideo.title}
                  duration={featuredVideo.duration}
                  audioEnabled={featuredVideo.audioEnabled}
                  position={1}
                  showIdleControls
                />
              </div>
              <div class="videos-featured__copy">
                <p class="videos-label videos-label--dark">Video destacado</p>
                <h2>{featuredVideo.title}</h2>
                <p>
                  Un registro de nuestra actividad profesional y del trabajo que realizamos
                  junto a especialistas, instituciones y referentes del sector.
                </p>
                <span>{featuredVideo.category}</span>
              </div>
            </article>

            <section data-videos-library class="videos-library">
              <header class="videos-library__header">
                <div>
                  <p class="videos-label">Biblioteca audiovisual</p>
                  <h2>Recorridos de producto e instrumental</h2>
                </div>
                <p>
                  Explorá el archivo completo. Cada video se carga únicamente cuando decidís
                  reproducirlo.
                </p>
              </header>

              <div class="videos-grid" data-videos-grid>
                {libraryVideos.map((video, index) => (
                  <article
                    data-video-item
                    data-video-library
                    data-category={video.category}
                    class:list={[
                      "videos-card",
                      index >= VIDEO_PAGE_SIZE && "hidden",
                    ]}
                  >
                    <VideoPlayer
                      assetId={video.id}
                      src={video.src}
                      poster={video.poster}
                      title={video.title}
                      duration={video.duration}
                      audioEnabled={video.audioEnabled}
                      position={index + 2}
                    />
                    <div class="videos-card__copy">
                      <span>{video.category}</span>
                      <h3>{video.title}</h3>
                      <small>Video {String(index + 2).padStart(2, "0")}</small>
                    </div>
                  </article>
                ))}
              </div>

              {libraryVideos.length > VIDEO_PAGE_SIZE && (
                <div class="videos-load-more" data-video-load-more-wrap>
                  <button type="button" data-video-load-more>
                    Cargar más videos
                    <span data-video-load-more-count>
                      ({libraryVideos.length - VIDEO_PAGE_SIZE})
                    </span>
                  </button>
                </div>
              )}
            </section>

            <div data-videos-empty class="videos-empty hidden">
              <p data-videos-empty-title></p>
              <p data-videos-empty-description></p>
            </div>
          </>
        ) : (
          <div data-videos-empty class="videos-empty">
            <div class="videos-empty__icon">
              <Icon name="calendar-clock" class="h-6 w-6" />
            </div>
            <div>
              <p data-videos-empty-title>
                Pronto publicaremos nuestros videos institucionales y de productos.
              </p>
              <p data-videos-empty-description>
                Mientras tanto, podés explorar imágenes de productos, instrumental y actividades profesionales.
              </p>
            </div>
            <a href="/galeria">Ir a la galería</a>
          </div>
        )}

        <aside class="videos-gallery-link">
          <span class="videos-gallery-link__icon">
            <Icon name="images" class="h-6 w-6" />
          </span>
          <div>
            <p>También podés recorrer la galería</p>
            <span>Productos, instrumental y presencia profesional en imágenes.</span>
          </div>
          <a href="/galeria">
            Ver galería
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </aside>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const filterWrap = document.querySelector("[data-video-filters]");
  const filterButtons = Array.from(document.querySelectorAll("[data-video-filter]"));
  const videoItems = Array.from(document.querySelectorAll("[data-video-item]"));
  const loadMoreWrap = document.querySelector("[data-video-load-more-wrap]");
  const loadMoreButton = document.querySelector("[data-video-load-more]");
  const loadMoreCount = document.querySelector("[data-video-load-more-count]");
  const emptyState = document.querySelector("[data-videos-empty]");
  const emptyTitle = emptyState?.querySelector("[data-videos-empty-title]");
  const emptyDescription = emptyState?.querySelector("[data-videos-empty-description]");
  const defaultEmptyTitle = emptyTitle?.textContent?.trim() || "Pronto publicaremos nuevos videos.";
  const defaultEmptyDescription = emptyDescription?.textContent?.trim() || "Podés recorrer la galería mientras incorporamos nuevo material.";
  const VIDEO_PAGE_SIZE = 12;
  let visibleLimit = VIDEO_PAGE_SIZE;
  let currentFilter = "Todos";

  const normalizeFilter = (value: string) =>
    value
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase();

  const findFilterButton = (filter: string) =>
    filterButtons.find(
      (item) =>
        item instanceof HTMLElement &&
        normalizeFilter(item.dataset.videoFilter || "") === normalizeFilter(filter),
    );

  const updateEmptyState = (filter: string, hasVisibleVideos: boolean) => {
    if (!(emptyState instanceof HTMLElement)) return;

    const hasVideos = videoItems.length > 0;
    emptyState.classList.toggle("hidden", hasVideos && hasVisibleVideos);

    if (!hasVideos && filter === "Todos") {
      if (emptyTitle) emptyTitle.textContent = defaultEmptyTitle;
      if (emptyDescription) emptyDescription.textContent = defaultEmptyDescription;
      return;
    }

    if (emptyTitle) {
      emptyTitle.textContent = `Todavía no hay videos de ${filter.toLowerCase()}.`;
    }
    if (emptyDescription) {
      emptyDescription.textContent = "Podés elegir otra categoría o recorrer la galería mientras incorporamos nuevo material.";
    }
  };

  const updateLoadMore = (matchingLibraryItems: number) => {
    if (!(loadMoreWrap instanceof HTMLElement)) return;

    const remaining = Math.max(matchingLibraryItems - visibleLimit, 0);
    loadMoreWrap.classList.toggle("hidden", remaining === 0);
    if (loadMoreCount) loadMoreCount.textContent = `(${remaining})`;
  };

  const setActiveFilter = (filter: string, resetLimit = true) => {
    const button = findFilterButton(filter) || findFilterButton("Todos");
    if (!(button instanceof HTMLElement)) return;

    const activeFilter = button.dataset.videoFilter || "Todos";
    currentFilter = activeFilter;
    if (resetLimit) visibleLimit = VIDEO_PAGE_SIZE;
    let visibleVideos = 0;
    let matchingLibraryItems = 0;

    filterButtons.forEach((item) => {
      if (!(item instanceof HTMLElement)) return;
      const active = item === button;
      item.classList.toggle("videos-filter-active", active);
      item.classList.toggle("videos-filter-idle", !active);
      item.setAttribute("aria-pressed", String(active));
    });

    videoItems.forEach((item) => {
      if (!(item instanceof HTMLElement)) return;
      const matchesCategory = activeFilter === "Todos" || item.dataset.category === activeFilter;
      const isLibraryItem = item.hasAttribute("data-video-library");

      if (isLibraryItem && matchesCategory) matchingLibraryItems += 1;

      const withinVisibleLimit =
        !isLibraryItem || matchingLibraryItems <= visibleLimit;
      const visible = matchesCategory && withinVisibleLimit;
      item.classList.toggle("hidden", !visible);
      if (visible) visibleVideos += 1;

      if (!visible) {
        const video = item.querySelector("video");
        if (video instanceof HTMLVideoElement) video.pause();
      }
    });

    updateLoadMore(matchingLibraryItems);
    updateEmptyState(activeFilter, visibleVideos > 0);
  };

  filterWrap?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const button = target.closest("[data-video-filter]");
    if (!(button instanceof HTMLElement)) return;
    setActiveFilter(button.dataset.videoFilter || "Todos");
  });

  loadMoreButton?.addEventListener("click", () => {
    visibleLimit += VIDEO_PAGE_SIZE;
    setActiveFilter(currentFilter, false);
  });

  const initialParams = new URLSearchParams(window.location.search);
  const initialFilter = initialParams.get("categoria") || initialParams.get("category") || initialParams.get("filter") || "Todos";
  setActiveFilter(initialFilter);
</script>

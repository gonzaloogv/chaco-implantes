---
import { wa } from "../data/site";
---

<a
  href={wa.sitio}
  target="_blank"
  rel="noopener noreferrer"
  class="floating-whatsapp"
  aria-label="Contactar por WhatsApp"
  title="Contactar por WhatsApp"
  data-floating-whatsapp
>
  <svg
    class="floating-whatsapp__icon"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    data-whatsapp-logo
  >
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.198.297-.767.966-.94 1.164-.173.198-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479s1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.81 9.81 0 0 1 6.988 2.895 9.825 9.825 0 0 1 2.9 6.988c-.002 5.45-4.437 9.884-9.888 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path>
  </svg>
</a>

<style>
  .floating-whatsapp {
    position: fixed;
    inset-block-end: max(1.25rem, env(safe-area-inset-bottom));
    inset-inline-start: max(1.25rem, env(safe-area-inset-left));
    z-index: 40;
    isolation: isolate;
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 1rem 2rem -0.75rem rgba(10, 57, 31, 0.55);
    transition:
      background-color 180ms var(--ease-out),
      box-shadow 180ms var(--ease-out),
      transform 180ms var(--ease-out);
  }

  .floating-whatsapp::before,
  .floating-whatsapp::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: rgba(37, 211, 102, 0.42);
  }

  .floating-whatsapp::before {
    animation: whatsapp-halo 2.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .floating-whatsapp::after {
    animation: whatsapp-breathe 2.8s ease-in-out infinite;
  }

  .floating-whatsapp__icon {
    width: 1.625rem;
    height: 1.625rem;
  }

  .floating-whatsapp:active {
    transform: scale(0.96);
  }

  @media (max-width: 39.999rem) {
    .floating-whatsapp {
      inset-block-end: max(1rem, env(safe-area-inset-bottom));
      inset-inline-start: max(1rem, env(safe-area-inset-left));
      width: 3.25rem;
      height: 3.25rem;
    }

    .floating-whatsapp__icon {
      width: 1.5rem;
      height: 1.5rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .floating-whatsapp:hover {
      background: #1ebe5d;
      box-shadow: 0 1.25rem 2.25rem -0.75rem rgba(10, 57, 31, 0.64);
      transform: translateY(-0.125rem);
    }
  }

  @keyframes whatsapp-halo {
    0% {
      opacity: 0.34;
      transform: scale(0.92);
    }

    72%,
    100% {
      opacity: 0;
      transform: scale(1.72);
    }
  }

  @keyframes whatsapp-breathe {
    0%,
    100% {
      opacity: 0.16;
      transform: scale(1);
    }

    50% {
      opacity: 0.08;
      transform: scale(1.32);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-whatsapp {
      transition-duration: 0.01ms;
    }

    .floating-whatsapp::before,
    .floating-whatsapp::after {
      animation: none;
    }
  }
</style>

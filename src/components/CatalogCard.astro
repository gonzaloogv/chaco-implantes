---
import Icon from "./Icon.astro";
import type { Category } from "../data/site";
import { categoryImages } from "../data/site";

interface Props {
  category: Category;
  compact?: boolean;
}

const { category, compact = false } = Astro.props;
const image = categoryImages[category.slug as keyof typeof categoryImages];
---

<!-- Imagen arriba (centrada, sin texto encima) y bloque de texto abajo, como en /catalogos.
     La compacta omite la descripción para no truncarla y conservar la altura de la card. -->
<a
  href={`/catalogos/${category.slug}`}
  aria-label={`Ver catálogo de ${category.title}`}
  data-catalog-card
  data-catalog-image-card
  data-catalog-category={category.slug}
  class:list={[
    "catalog-image-card line-card card-link group overflow-hidden rounded-xl border border-border",
    compact ? "line-card--compact h-72" : "h-80",
  ]}
>
  <div class="line-card__media">
    <img
      src={image}
      alt={category.title}
      loading="lazy"
      decoding="async"
      width="1024"
      height="768"
    />
  </div>

  <div class="line-card__body">
    <div class="line-card__copy">
      <span class="line-card__tag">{category.tag}</span>
      <h2 class="font-display">{category.title}</h2>
      {!compact && <p>{category.description}</p>}
      {!compact && (
        <span class="line-card__link">
          Ver catálogo <Icon name="arrow-right" class="catalog-card-arrow h-4 w-4" />
        </span>
      )}
    </div>
    {compact && (
      <span class="line-card__arrow" aria-hidden="true">
        <Icon name="arrow-right" class="catalog-card-arrow h-4 w-4" />
      </span>
    )}
  </div>
</a>
